{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":pinDependencies",
    "security:minimumReleaseAgePypi",
    "helpers:pinGitHubActionDigestsToSemver",
    "security:openssf-scorecard",
    ":semanticCommits",
    "customManagers:githubActionsVersions"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "importTools/**"
  ],
  "packageRules": [
    {
      "description": "The sdk is a library: widen ranges instead of raising the minimum",
      "matchFileNames": ["sdk/**"],
      "rangeStrategy": "widen"
    },
    {
      "description": "Update GitHub Actions together",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action", "workflow"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Update semantic-release and its plugins together",
      "matchPackageNames": [
        "semantic-release",
        "@semantic-release/**",
        "conventional-changelog-conventionalcommits"
      ],
      "groupName": "semantic-release"
    },
    {
      "description": "Update jasmine and its type definitions together",
      "matchPackageNames": ["jasmine-core", "@types/jasmine"],
      "groupName": "jasmine"
    }
  ]
}
